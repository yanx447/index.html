{
 "name": "ფანდური — Panduri Learning",
 "short_name": "ფანდური",
 "description": "Learn the Georgian three-string panduri with lessons that wait for you.",
 "lang": "ka",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "orientation": "any",
 "background_color": "#130C07",
 "theme_color": "#130C07",

  {
   "src": "icons/icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icons/icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icons/maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "id": "/panduri/app/",
 "display_override": [
  "window-controls-overlay",
  "standalone",
  "minimal-ui",
  "browser"
 ],
 "categories": [
  "education",
  "music"
 ],

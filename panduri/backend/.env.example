# Server environment only. Do not copy to source/config.json or the app bundle.
# Exact public application URL, including the GitHub Pages subpath.
APP_URL=https://yanx447.github.io/index.html/panduri/app/
# Supabase provides SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY automatically.

# Activate card, Apple Pay (9) and Google Pay (14) through your TBC merchant agreement.
TBC_API_KEY=
TBC_CLIENT_ID=
TBC_CLIENT_SECRET=

# Register a PayPal Business merchant and REST app. Start in sandbox; then set live credentials.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# Owner-approved prices; PayPal cannot charge GEL. Supply USD or EUR prices before enabling it.
PAYPAL_CURRENCY=EUR
PAYPAL_MONTHLY_PRICE=5.17
PAYPAL_YEARLY_PRICE=41.38

# RevenueCat wraps Apple StoreKit / Google Play Billing. SDK keys are public and returned only by catalog.
REVENUECAT_IOS_KEY=
REVENUECAT_ANDROID_KEY=
REVENUECAT_SECRET_KEY=
# Generate a random, long value and configure the same Bearer header in RevenueCat webhook settings.
REVENUECAT_WEBHOOK_TOKEN=
# Use a separate staging Supabase project for sandbox purchases. Leave false in production.
BILLING_ALLOW_SANDBOX=false
# Store purchases stay disabled until real HTTPS policy pages are supplied.
TERMS_URL=
PRIVACY_URL=
